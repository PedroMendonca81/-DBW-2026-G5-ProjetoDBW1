<header class="barra-cinzenta">
    
    <h1 class="logo-texto">Matrioska</h1>

    <% if (typeof tipo !== 'undefined' && tipo === 'completo')  { %>
        <a href="/profile" class="header-perfil-link">
            <div class="user-info">
                <span class="user-name">
                    <%= (typeof user !== 'undefined' && user) ? user.username : 'Convidado' %>
                </span>
                
                <img src="/images/<%= (typeof user !== 'undefined' && user && user.imagemPerfil) ? user.imagemPerfil : 'default.png' %>" alt="Foto de Perfil" class="user-pfp">
            </div>
        </a>
    <% } %>

</header>