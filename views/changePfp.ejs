<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mudar PFP</title>
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>

    <div class="ecra-jogo">
        
        <header class="barra-cinzenta">
            <button class="btn-jogo">Matrioska</button>
        </header>

        <main class="zona-meio">
            <div class="lateral-preta"></div> 
            
            <div class="area-central">
                <div class="conteudo-form-pfp">
                    
                    <img src="/images/<%= user.imagemPerfil %>" alt="Foto atual" class="foto-perfil form-foto">

                    <form action="/profile/change-pfp" method="POST" enctype="multipart/form-data">
                        <input type="file" name="novaPfp" accept="image/*" required style="margin-bottom: 15px;">
                        <button type="submit">Guardar Nova Foto</button>
                    </form>
                </div>
            </div>

            <div class="lateral-preta"></div> 
        </main>

        <footer class="barra-cinzenta">
            <a href="/profile" class="btn-voltar">Voltar</a>
        </footer>

    </div>

</body>
</html>