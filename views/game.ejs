<!DOCTYPE html>
<html lang="pt">
<head>
    <%- include('partials/head', { title: 'Matrioska - Jogo' }) %>
    <link rel="stylesheet" href="/css/lobby.css"> 
    <link rel="stylesheet" href="/css/game.css">
</head>
<body>
    <div class="jogo">
        <%- include('partials/header', { tipo: 'completo' }) %>

        <main class="zona-meio">
            <aside class="lateral-preta"></aside>
            
            <section class="area-central">
                <div class="info-partida">
                    <div class="caixa-tempo" id="tempo-valor">30s</div>
                    <div class="caixa-pontuacao" id="pontos-valor">0 pontos</div>
                </div>

                <% if (typeof modoJogo !== 'undefined' && modoJogo === 'online') { %>
                    <div class="zona-adversarios" id="zona-adversarios">
                        <div class="cartao-adversario" id="cartao-adv-1">
                            <span class="nome-adv" id="nome-adv-1">Aguardando...</span>
                            <span class="pontos-adv" id="pontos-adv-1">0 pts</span>
                        </div>
                        <div class="cartao-adversario" id="cartao-adv-2">
                            <span class="nome-adv" id="nome-adv-2">Aguardando...</span>
                            <span class="pontos-adv" id="pontos-adv-2">0 pts</span>
                        </div>
                        <div class="cartao-adversario" id="cartao-adv-3">
                            <span class="nome-adv" id="nome-adv-3">Aguardando...</span>
                            <span class="pontos-adv" id="pontos-adv-3">0 pts</span>
                        </div>
                    </div>
                <% } %>

                <article class="tabuleiro-jogo">
                    <h1 class="palavra-mestra">SOLIDARIEDADE</h1>
                    
                    <form class="form-resposta">
                        <input type="text" id="input-resposta" name="resposta" class="input-resposta" placeholder="Adivinha..." autofocus autocomplete="off" required>
                        <button type="submit" class="btn-enviar">ADIVINHAR</button>
                    </form>

                    <form id="form-fim-jogo" action="/game/end" method="POST" style="display: none;">
                        <input type="hidden" name="pontosFinais" id="input-pontos-finais">
                        <input type="hidden" name="certasFinais" id="input-certas-finais">
                        
                        <input type="hidden" name="erradasFinais" id="input-erradas-finais">
                        <input type="hidden" name="tempoFinal" id="input-tempo-final">
                    </form>
                </article>
            </section>
            
            <aside class="lateral-preta"></aside>
        </main>

<%- include('partials/footer', { tipo: 'jogo' }) %>
    </div>

    <script src="/socket.io/socket.io.js"></script>

    <script>
        // Força a ligação ao endereço local onde o Node está a correr
        const socket = io("http://localhost:3000"); 

        // Debug para veres no console (F12) se a ligação funcionou
        socket.on('connect', () => {
            console.log("✅ Conectado ao servidor! ID:", socket.id);
        });

        socket.on('connect_error', (error) => {
            console.error("❌ Erro na ligação socket:", error);
        });

        // Passamos o nome do user para o JS
        const USERNAME_LOGADO = "<%= user ? user.username : 'Jogador' %>";
    </script>
    
    <div id="nome-user-logado" style="display: none;"><%= user ? user.username : 'Jogador' %></div>

    <script src="/js/jogo.js"></script>
</body>
</html>